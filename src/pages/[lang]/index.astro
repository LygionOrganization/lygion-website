---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { copy, isLanguage, languages, wikiLinks, type Language } from "../../data/i18n";
import { getProductDetailPath, getProductsByModule, modules, type ModuleId } from "../../data/products";
import { withBase } from "../../utils/paths";

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}

const langParam = Astro.params.lang;
const lang: Language = isLanguage(langParam) ? langParam : "zh";
const t = copy[lang];

const moduleIcons: Record<ModuleId, string> = {
  "bus-devices": "M5 7h14v10H5z M8 7V4m8 3V4M8 20v-3m8 3v-3M2 10h3m-3 4h3m14-4h3m-3 4h3",
  "robot-modules": "M12 4l7 4v8l-7 4-7-4V8z M12 12l7-4M12 12v8M12 12 5 8",
  "robot-systems": "M12 2v4M9 3h6M7 7h10l2 4v6H5v-6zM8 17v2m8-2v2M7 19h10M9 11h6M12 11v3",
  "lygion-open": "M8 7l-5 5 5 5M16 7l5 5-5 5M14 4l-4 16"
};
---

<BaseLayout lang={lang}>
  <main>
    <section class="hero">
      <img class="hero-media" src={withBase("/images/lygion-product-banner-dark-no-ttl-node.png")} alt="" loading="eager" />
      <div class="hero-overlay"></div>
      <div class="hero-content">
        <h1>{t.heroTitle}</h1>
        <p>{t.heroLead}</p>
        <div class="hero-actions">
          <a class="button primary" href="#modules">{t.heroPrimary}</a>
          <a class="button ghost" href={wikiLinks[lang]} target="_blank" rel="noreferrer">{t.heroSecondary}</a>
        </div>
      </div>
    </section>

    <section class="section intro" id="modules">
      <div class="section-heading modules-heading">
        <p class="eyebrow">Portfolio System</p>
        <h2>{t.modulesTitle}</h2>
      </div>
      <div class="module-grid">
        {
          modules.map((module) => (
            <a class={`module-card accent-${module.accent}`} href={withBase(`/${lang}/modules/${module.id}/`)}>
              <span class="module-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                  <defs>
                    <linearGradient id={`module-gradient-${module.id}`} x1="3" y1="3" x2="21" y2="21" gradientUnits="userSpaceOnUse">
                      <stop stop-color="#8b5cf6" />
                      <stop offset="1" stop-color="#3f5cff" />
                    </linearGradient>
                  </defs>
                  <path d={moduleIcons[module.id]} style={`stroke: url(#module-gradient-${module.id})`} />
                </svg>
              </span>
              <div>
                <h3>{module.name[lang]}</h3>
                <p>{module.summary[lang]}</p>
              </div>
            </a>
          ))
        }
      </div>
    </section>

    <section class="section products-section" id="products">
      <div class="product-module-list">
        {
          modules.map((module) => {
            const moduleProducts = getProductsByModule(module.id);

            if (!moduleProducts.length) {
              return null;
            }

            return (
              <section class="product-module-group" aria-labelledby={`products-${module.id}`}>
                <div class="product-module-heading">
                  <div>
                    <p class="eyebrow">Product Type</p>
                    <h3 id={`products-${module.id}`}>{module.name[lang]}</h3>
                    <p>{module.description[lang]}</p>
                  </div>
                  <a class={`text-link accent-${module.accent}`} href={withBase(`/${lang}/modules/${module.id}/`)}>
                    {module.name[lang]}
                  </a>
                </div>
                <div class="product-grid">
                  {
                    moduleProducts.map((product) => (
                      <a class="product-card" href={withBase(getProductDetailPath(product, lang))} target="_blank" rel="noopener noreferrer">
                        <span class="product-card-media">
                          <img src={withBase(product.image)} alt="" loading="lazy" />
                        </span>
                        <div>
                          <span class={`tag accent-${module.accent}`}>{module.name[lang]}</span>
                          <h3>{product.name[lang]}</h3>
                          <p>{product.summary[lang]}</p>
                        </div>
                      </a>
                    ))
                  }
                </div>
              </section>
            );
          })
        }
      </div>
    </section>

    <section class="section open-band" id="open">
      <div>
        <p class="eyebrow">{t.githubEyebrow}</p>
        <h2>{t.ctaTitle}</h2>
        <p>{t.ctaLead}</p>
      </div>
      <a class="button primary" href="https://github.com/orgs/LygionOrganization/repositories" target="_blank" rel="noreferrer">
        {t.githubButton}
      </a>
    </section>
  </main>
</BaseLayout>
