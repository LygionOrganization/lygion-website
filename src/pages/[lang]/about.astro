---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { copy, isLanguage, languages, type Language } from "../../data/i18n";

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}

const langParam = Astro.params.lang;
const lang: Language = isLanguage(langParam) ? langParam : "zh";
const t = copy[lang];
const about = t.about;
---

<BaseLayout lang={lang} title={about.title} description={about.lead}>
  <main class="about-page">
    <section class="about-hero">
      <div class="about-hero-copy">
        <p class="eyebrow">{about.eyebrow}</p>
        <h1>{about.title}</h1>
        <p>{about.lead}</p>
      </div>
    </section>

    <section class="section about-system">
      <div class="section-heading split-heading">
        <div>
          <p class="eyebrow">Product System</p>
          <h2>{about.systemTitle}</h2>
        </div>
        <p>{about.systemLead}</p>
      </div>

      <div class="about-pillar-grid">
        {
          about.pillars.map((pillar, index) => (
            <article class="about-pillar">
              <span>{String(index + 1).padStart(2, "0")}</span>
              <h3>{pillar.title}</h3>
              <p>{pillar.text}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="section about-mission">
      <div>
        <p class="eyebrow">Our Focus</p>
        <h2>{about.missionTitle}</h2>
        <p>{about.missionText}</p>
      </div>
    </section>

    <section class="section about-contact">
      <div>
        <p class="eyebrow">{about.emailLabel}</p>
        <h2>{about.contactTitle}</h2>
        <p>{about.contactLead}</p>
      </div>
      <div class="about-contact-links">
        <a href="mailto:effectsmachine@outlook.com">effectsmachine@outlook.com</a>
        <a href="mailto:effectsmachine@gmail.com">effectsmachine@gmail.com</a>
      </div>
    </section>
  </main>
</BaseLayout>
