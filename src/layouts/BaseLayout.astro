---
import { copy, languageLabels, wikiLinks, type Language } from "../data/i18n";
import { modules } from "../data/products";
import { withBase } from "../utils/paths";
import "../styles/global.css";

type Props = {
  lang: Language;
  title?: string;
  description?: string;
};

const { lang, title, description } = Astro.props;
const t = copy[lang];
const alternateLang = lang === "zh" ? "en" : "zh";
const pageTitle = title ? `${title} | Lygion` : "Lygion";
const pageDescription = description ?? t.heroLead;
const currentPath = Astro.url.pathname;
const alternatePath = currentPath.replace(`/${lang}`, `/${alternateLang}`);
const basePath = import.meta.env.BASE_URL.replace(/\/$/, "");
const publicPath = basePath && currentPath.startsWith(basePath)
  ? currentPath.slice(basePath.length)
  : currentPath;
const canonicalUrl = new URL(publicPath, Astro.site);
const alternatePublicPath = publicPath.replace(`/${lang}`, `/${alternateLang}`);
const alternateUrl = new URL(alternatePublicPath, Astro.site);
---

<!doctype html>
<html lang={lang === "zh" ? "zh-CN" : "en"}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang={lang === "zh" ? "zh-Hans" : "en"} href={canonicalUrl} />
    <link rel="alternate" hreflang={alternateLang === "zh" ? "zh-Hans" : "en"} href={alternateUrl} />
    <link rel="alternate" hreflang="x-default" href={new URL("/en/", Astro.site)} />
    <link rel="icon" type="image/png" href={withBase("/favicon.png")} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={withBase(`/${lang}/`)} aria-label="Lygion home">
        <span class="brand-mark">
          <img src={withBase("/assets/lygion-logo-mark.png")} alt="" />
        </span>
        <span>
          <strong>Lygion</strong>
          <small>Robotics</small>
        </span>
      </a>
      <nav class="nav" aria-label="Primary navigation">
        <a href="https://lygionorganization.github.io/lygion-website/" target="_blank" rel="noreferrer">
          {t.nav.githubPages}
        </a>
        <a href={wikiLinks[lang]} target="_blank" rel="noreferrer">{t.nav.wiki}</a>
        {modules.map((module) => <a href={withBase(`/${lang}/modules/${module.id}/`)}>{t.nav[module.navKey]}</a>)}
        <a href={withBase(`/${lang}/about/`)}>{t.nav.about}</a>
      </nav>
      <a class="language-switch" href={alternatePath}>
        {languageLabels[alternateLang]}
      </a>
    </header>
    <slot />
    <footer class="site-footer">
      <span>{t.footer}</span>
      <a href="mailto:effectsmachine@outlook.com">effectsmachine@outlook.com</a>
      <a href="https://shop349435383.taobao.com/?spm=pc_detail.30350276.shop_block.dshopinfo.2ccb5e35emF1gh" target="_blank" rel="noreferrer">
        {lang === "zh" ? "灵影智能企业店" : "Lygion Taobao Store"}
      </a>
    </footer>
  </body>
</html>
