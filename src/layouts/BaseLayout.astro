---
import { copy, languageLabels, wikiLinks, type Language } from "../data/i18n";
import { modules } from "../data/products";
import "../styles/global.css";

type Props = {
  lang: Language;
  title?: string;
  description?: string;
};

const { lang, title, description } = Astro.props;
const t = copy[lang];
const alternateLang = lang === "zh" ? "en" : "zh";
const pageTitle = title ? `${title} | Lygion` : "Lygion Robotics";
const pageDescription = description ?? t.heroLead;
const currentPath = Astro.url.pathname;
const alternatePath = currentPath.replace(`/${lang}`, `/${alternateLang}`);
---

<!doctype html>
<html lang={lang === "zh" ? "zh-CN" : "en"}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={pageDescription} />
    <link rel="icon" href="/favicon.svg" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={`/${lang}/`} aria-label="Lygion home">
        <span class="brand-mark">
          <img src="/assets/lygion-logo-mark.png" alt="" />
        </span>
        <span>
          <strong>Lygion</strong>
          <small>Robotics</small>
        </span>
      </a>
      <nav class="nav" aria-label="Primary navigation">
        <a href={wikiLinks[lang]} target="_blank" rel="noreferrer">{t.nav.wiki}</a>
        {modules.map((module) => <a href={`/${lang}/modules/${module.id}/`}>{t.nav[module.navKey]}</a>)}
        <a href="mailto:hello@lygion.ai">{t.nav.contact}</a>
      </nav>
      <a class="language-switch" href={alternatePath}>
        {languageLabels[alternateLang]}
      </a>
    </header>
    <slot />
    <footer class="site-footer">
      <span>{t.footer}</span>
      <span>lygion.ai</span>
    </footer>
  </body>
</html>
